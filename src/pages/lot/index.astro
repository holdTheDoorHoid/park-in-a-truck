---
// Find a lot: the City-data tools in one place — look up an address, browse
// the vacant-land map, compare possible lots, then on to the steps.
import Base from '../../layouts/Base.astro';
import LotFinderMap from '../../components/widgets/LotFinderMap.astro';
import LotLookup from '../../components/widgets/LotLookup.astro';
import { u } from '../../lib/url';
---
<Base title="Find a lot" description="Look up any Philadelphia lot's owner, size, zoning and vacancy, and browse vacant land on a map.">
  <section class="wrap lot-page">
    <p class="eyebrow">Step 1 · Acquire</p>
    <h1 class="ruled">Find a lot</h1>
    <p class="lede">
      Type an address, or browse the map of vacant land. The site checks the same City records atlas.phila.gov
      shows — owner, lot size, zoning, vacancy — and tells you which Park in a Truck size fits.
    </p>

    <h2 class="ruled">Look up an address</h2>
    <LotLookup mode="primary" />

    <h2 class="ruled">Vacant land near you</h2>
    <p>
      Lots the City lists as vacant land, coloured by who owns them. Click one to see its owner and size, then save it
      as your park lot or add it to your list. Walk the block too — the City's list misses some lots and includes some
      that are already in use.
    </p>
    <LotFinderMap height="min(75vh, 640px)" />

    <h2 class="ruled">Compare your possible lots</h2>
    <LotLookup mode="candidates" />

    <h2 class="ruled">Next steps</h2>
    <div class="grid next">
      <a class="card card-link" href={u('steps/acquire/#who-owns-that-lot')}>
        <h3>Who owns that lot?</h3>
        <p>Public or private owner — the ways to get the right to build a park.</p>
      </a>
      <a class="card card-link" href={u('steps/organize/')}>
        <h3>Organize</h3>
        <p>Community organizations, schools, gardens and other assets near your lot.</p>
      </a>
      <a class="card card-link" href={u('steps/assess/')}>
        <h3>Assess</h3>
        <p>Measured edges, a printable base map, trees and neighboring buildings.</p>
      </a>
      <a class="card card-link" href={u('planner/')}>
        <h3>Plan in 3D</h3>
        <p>Fit the park pieces to your lot and see sun and shade.</p>
      </a>
    </div>
  </section>
</Base>
<style>
  .lot-page {
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .lot-page h2 {
    margin-top: 2.2em;
  }
  .next {
    margin-top: 12px;
  }
</style>
