---
// Find a lot: the City-data tools in one place — look up an address, browse
// the vacant-land map, compare possible lots, then on to the steps.
import Base from '../../layouts/Base.astro';
import LotFinderMap from '../../components/widgets/LotFinderMap.astro';
import LotLookup from '../../components/widgets/LotLookup.astro';
import pages from '../../i18n/messages/en/pages.ts';
import { getT, urlFor } from '../../i18n/astro.ts';

const t = getT(Astro, pages);
const u = urlFor(t.locale);
---
<Base title={t('lot.title')} description={t('lot.description')}>
  <section class="wrap lot-page">
    <p class="eyebrow">{t('lot.eyebrow')}</p>
    <h1 class="ruled">{t('lot.h1')}</h1>
    <p class="lede">{t('lot.lede')}</p>

    <h2 class="ruled">{t('lot.lookupH2')}</h2>
    <LotLookup mode="primary" />

    <h2 class="ruled">{t('lot.mapH2')}</h2>
    <p>{t('lot.mapText')}</p>
    <LotFinderMap height="min(75vh, 640px)" />

    <h2 class="ruled">{t('lot.compareH2')}</h2>
    <LotLookup mode="candidates" />

    <h2 class="ruled">{t('lot.nextH2')}</h2>
    <div class="grid next">
      <a class="card card-link" href={u('steps/acquire/#who-owns-that-lot')}>
        <h3>{t('lot.next.owner.title')}</h3>
        <p>{t('lot.next.owner.text')}</p>
      </a>
      <a class="card card-link" href={u('steps/organize/')}>
        <h3>{t('lot.next.organize.title')}</h3>
        <p>{t('lot.next.organize.text')}</p>
      </a>
      <a class="card card-link" href={u('steps/assess/')}>
        <h3>{t('lot.next.assess.title')}</h3>
        <p>{t('lot.next.assess.text')}</p>
      </a>
      <a class="card card-link" href={u('planner/')}>
        <h3>{t('lot.next.planner.title')}</h3>
        <p>{t('lot.next.planner.text')}</p>
      </a>
    </div>
  </section>
</Base>
<style>
  .lot-page {
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .lot-page h2 {
    margin-top: 2.2em;
  }
  .next {
    margin-top: 12px;
  }
</style>
