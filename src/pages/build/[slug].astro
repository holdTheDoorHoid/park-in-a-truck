---
// /build/<slug>/ — one assembly guide: hero, at-a-glance, materials + tools
// checklists, "before you begin" (safety), cut list, numbered steps with enlargeable
// diagrams, finishing notes, supplier links, PDF download, prev/next. Owner: guides workstream
// (content); the page layout and the 3D viewer beside the steps: guide3d-viewer.
//
// When src/data/guides/models/<slug>.json exists, the steps get a 3D model beside
// them (sticky column on desktop, sticky strip on phones) that builds itself as
// you scroll. Without a model — or without WebGL/JS — the page is unchanged.
import Base from '../../layouts/Base.astro';
import Checklist from '../../components/workbook/Checklist.astro';
import Download from '../../components/workbook/Download.astro';
import Callout from '../../components/workbook/Callout.astro';
import CutListTable from '../../components/guides/CutListTable.astro';
import StepBlock from '../../components/guides/StepBlock.astro';
import { getGuides, getGuide } from '../../data/guides';
import GuideViewer from '../../components/guides3d/GuideViewer.astro';
import { asBuiltText, feetIn } from '../../components/guides/format';
import { imageSize } from '../../components/guides/imageSize';
import { u as fileUrl } from '../../lib/url';
import type { GuideModel } from '../../lib/guides3d/schema';
import guidesMsgs from '../../i18n/messages/en/guides.ts';
import parksMsgs from '../../i18n/messages/en/parks.ts';
import { getT, urlFor, localizeGuide, localizedModelReason } from '../../i18n/astro.ts';

const models = import.meta.glob<GuideModel>('../../data/guides/models/*.json', { eager: true, import: 'default' });

export function getStaticPaths() {
  return getGuides().map((guide) => ({ params: { slug: guide.slug } }));
}
// No props: the page is found by its slug. (Declared so the /<lang>/ twin can render it.)
type Props = Record<string, never>;

const { slug } = Astro.params;
const t = getT(Astro, guidesMsgs);
const u = urlFor(t.locale);
// "(in English)" after links to English-only shops and pages — the parks page's words for the same thing
const inEnglish = t.locale === 'en' ? '' : `${t.space}${getT(Astro, parksMsgs)('link.english')}`;
// English is the source: checkmarks are saved under the ENGLISH item names, so a list checked
// off in one language stays checked in every other. Only the text shown is translated.
const english = getGuide(slug!)!;
const guide = localizeGuide(english, t.locale);
const fallback = !guide.translated;
const contentLang = fallback ? ({ lang: 'en', dir: 'ltr' } as const) : {};

const all = getGuides().map((g) => localizeGuide(g, t.locale));
const i = all.findIndex((g) => g.slug === guide.slug);
const prev = all[i - 1];
const next = all[i + 1];
const dims = (d: { length: number; width: number; height: number }) =>
  t('dims', { length: feetIn(d.length), width: feetIn(d.width), height: feetIn(d.height) });

const englishLines = [...english.materials, ...english.hardware];
// Sizes (2x4x8', 2-1/2" x 1/4") read left to right: kept in one piece on right-to-left pages.
const sizeNote = (size?: string) => (size ? ` (${t.isolate(size)})` : '');
const materialItems = [...guide.materials, ...guide.hardware].map((m, idx) => ({
  value: `${idx}-${englishLines[idx]!.item}`,
  label: `${m.qty}× ${m.item}${sizeNote(m.size)}`,
  hint: m.notes,
}));
const toolItems = guide.tools.map((label, idx) => ({ value: english.tools[idx]!, label }));

// site-added: where the guide's own materials list doesn't add up, a note marked as ours
const materialNotes = [...guide.materials, ...guide.hardware]
  .filter((m) => m.siteNote)
  .map((m) => ({ label: `${m.qty}× ${m.item.split(' — ')[0]}${sizeNote(m.size)}`, note: m.siteNote! }));

const model = Object.values(models).find((m) => m.slug === guide.slug);
// site-added: where PiaT's stated size is nominal, say what the parts actually build
const asBuilt = model?.asBuilt ? asBuiltText(guide.dimensionsIn, model.asBuilt, t) : '';
// the model's own note, in the language when its models overlay has it (English, marked so, otherwise)
const reason = model?.asBuilt?.reason ? localizedModelReason(guide.slug, model.asBuilt.reason.trim(), t.locale) : null;
// English notes may lack a final full stop; a translation ends however its language does
const asBuiltReason = reason ? (reason.translated && t.locale !== 'en' ? reason.text : reason.text.replace(/([^.!?])$/, '$1.')) : '';
const reasonLang = reason && !reason.translated ? ({ lang: 'en', dir: 'ltr' } as const) : {};

const glance: { label: string; value: string }[] = [{ label: t('glance.size'), value: dims(guide.dimensionsIn) }];
if (guide.time) glance.push({ label: t('glance.time'), value: guide.time });
if (guide.people) glance.push({ label: t('glance.people'), value: guide.people });
if (guide.skill) glance.push({ label: t('glance.skill'), value: guide.skill });
if (guide.cost) glance.push({ label: t('glance.cost'), value: guide.cost });
---

<Base title={guide.title} description={guide.summary}>
  <header class="hero wrap">
    <p class="eyebrow no-print">
      <a href={u('build/')}>{t('crumb')}</a> · {t(`cat.${guide.category}`)}
    </p>
    <div class="hero-grid">
      <div class="hero-media">
        <img src={fileUrl(`img/guides/${guide.slug}/hero.webp`)} alt={t('heroAlt', { title: guide.title })} {...(imageSize(`img/guides/${guide.slug}/hero.webp`) ?? {})} />
      </div>
      <div class="hero-copy" {...contentLang}>
        <h1 class="ruled">{guide.title}</h1>
        <p class="lede">{guide.summary}</p>
        <dl class="glance">
          {glance.map((g) => (
            <div>
              <dt>{g.label}</dt>
              <dd>{g.value}</dd>
            </div>
          ))}
        </dl>
        {asBuilt && (
          <p class="as-built">
            {t('asBuilt', { size: asBuilt })}
            {/* site-added: the reason comes from the 3D model's own note (translated through the
                `models/<slug>` overlay; marked English on its own until it is). */}
            {asBuiltReason && <>{t.space}<span {...reasonLang}>{asBuiltReason}</span></>}
          </p>
        )}
        <div class="hero-actions no-print">
          <Download href={guide.pdf} label={t('pdf')} />
          <button class="btn btn-small" type="button" onclick="window.print()">{t('print')}</button>
        </div>
      </div>
    </div>
    {fallback && <p class="callout callout-note">{t('notTranslated')}</p>}
  </header>

  <section class="wrap section" {...contentLang}>
    <h2 class="ruled">{t('need')}</h2>
    <div class="need-grid">
      <div>
        <Checklist id={`build.${guide.slug}.materials`} label={t('materials')} items={materialItems} />
        {materialNotes.length > 0 && (
          <Callout kind="site">
            {materialNotes.map((m) => (
              <p><strong>{m.label}:</strong> {m.note}</p>
            ))}
          </Callout>
        )}
      </div>
      <div>
        <Checklist id={`build.${guide.slug}.tools`} label={t('tools')} items={toolItems} />
      </div>
    </div>
  </section>

  {/* Read before anything is cut (the PDFs put this up front too). */}
  {guide.safety && guide.safety.length > 0 && (
    <section class="wrap section" {...contentLang}>
      <h2 class="ruled">{t('safety')}</h2>
      <div class="callout callout-warning before-begin">
        <ul>
          {guide.safety.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="wrap section" {...contentLang}>
    <h2 class="ruled">{t('cut')}</h2>
    <CutListTable items={guide.cutList} />
  </section>

  <section class="wrap section" {...contentLang}>
    <h2 class="ruled">{t('steps')}</h2>
    {model ? (
      <div class="steps-layout" data-g3d="pending">
        <aside class="g3d-col no-print" aria-label={t('model', { title: guide.title })}>
          <GuideViewer guide={guide} />
        </aside>
        <ol class="steps">
          {guide.steps.map((step) => <StepBlock step={step} />)}
        </ol>
      </div>
    ) : (
      <ol class="steps">
        {guide.steps.map((step) => <StepBlock step={step} />)}
      </ol>
    )}
  </section>
  {model && (
    <script is:inline>
      // Switch to the two-column layout before first paint when WebGL looks
      // available; the viewer island confirms it (or turns it off) once loaded.
      (function () {
        var l = document.querySelector('.steps-layout');
        if (l && window.WebGLRenderingContext && window.matchMedia) l.setAttribute('data-g3d', 'on');
      })();
    </script>
  )}

  {guide.finishing && (
    <section class="wrap section" {...contentLang}>
      <h2 class="ruled">{t('finishing')}</h2>
      <div class="prose">
        {guide.finishing.split('\n\n').map((p) => <p>{p}</p>)}
      </div>
    </section>
  )}

  {guide.links.length > 0 && (
    <section class="wrap section no-print" {...contentLang}>
      <h2 class="ruled">{t('links')}</h2>
      <ul class="links">
        {guide.links.map((l) => (
          <li><a href={l.url} target="_blank" rel="noopener" hreflang="en">{l.label}</a>{inEnglish}</li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap section no-print">
    <p class="muted source">{t('source', { pages: guide.sourcePages })}</p>
    <Download href={guide.pdf} label={t('download', { title: guide.title })} />
  </section>

  <nav class="wrap pager no-print" aria-label={t('pager')}>
    {prev ? <a class="btn" href={u(`build/${prev.slug}/`)}>← {prev.title}</a> : <span></span>}
    {next ? <a class="btn btn-primary" href={u(`build/${next.slug}/`)}>{next.title} →</a> : <span></span>}
  </nav>

  <dialog id="lightbox" class="lightbox no-print">
    <button type="button" class="lightbox-close" data-close aria-label={t('close')}>✕</button>
    <img data-lightbox-img alt="" />
  </dialog>
</Base>

<script>
  function setup() {
    const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!dlg) return;
    const img = dlg.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('[data-enlarge]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!img) return;
        img.src = btn.dataset.src || '';
        img.alt = btn.dataset.alt || '';
        dlg.showModal();
      });
    });
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
  else setup();
</script>

<style>
  .hero {
    padding-top: 32px;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: underline;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 32px;
    align-items: center;
    margin-top: 14px;
  }
  .hero-media {
    border-radius: var(--radius);
    display: grid;
    place-items: center;
    padding: 12px;
    background: var(--paper-2);
  }
  .hero-media img {
    width: 100%;
  }
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 14px;
    margin: 20px 0 0;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .glance dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .glance dd {
    margin: 0.2em 0 0;
    font-weight: 700;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .hero-actions :global(.download) {
    margin: 0;
  }
  .section {
    padding-block: 36px;
    border-top: 1px solid var(--line);
  }
  .need-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .as-built {
    margin: 10px 0 0;
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  /* ---- 3D model beside the steps (only when the viewer is on) ---------------- */
  .steps-layout:not([data-g3d='on']) .g3d-col {
    display: none;
  }
  @media (min-width: 1000px) {
    .steps-layout[data-g3d='on'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(360px, 0.82fr);
      gap: 40px;
      align-items: start;
    }
    .steps-layout[data-g3d='on'] .steps {
      grid-column: 1;
      grid-row: 1;
    }
    .steps-layout[data-g3d='on'] .g3d-col {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--g3d-top, 65px) + 20px);
      height: min(calc(100vh - var(--g3d-top, 65px) - 40px), 860px);
      padding-top: 28px;
    }
    /* the steps column is narrower now: text above its drawing */
    .steps-layout[data-g3d='on'] :global(.step-body) {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
  @media (max-width: 999.98px) {
    /* phones & tablets: a sticky strip above the steps; the text scrolls below it */
    .steps-layout[data-g3d='on'] .g3d-col {
      position: sticky;
      top: var(--g3d-top, 65px);
      z-index: 20;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 6px 12px -10px rgb(0 0 0 / 0.35);
      height: clamp(230px, 42vh, 440px);
      height: clamp(230px, 42svh, 440px);
    }
    .steps-layout[data-g3d='on'][data-g3d-collapsed='1'] .g3d-col {
      height: auto;
    }
    .steps-layout[data-g3d='on'] :global(.step) {
      scroll-margin-top: calc(var(--g3d-top, 65px) + var(--g3d-h, 0px) + 12px);
    }
  }
  @media print {
    .steps-layout {
      display: block !important;
    }
  }
  .before-begin {
    margin: 0;
    max-width: 72ch;
  }
  .before-begin ul {
    margin: 0;
    padding-inline-start: 1.2em;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .source {
    font-size: 0.85rem;
    margin-bottom: 14px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 24px 0 48px;
  }
  .lightbox {
    border: 0;
    border-radius: var(--radius);
    padding: 0;
    max-width: min(92vw, 1200px);
    max-height: 90vh;
    background: #000;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.78);
  }
  .lightbox img {
    display: block;
    max-width: min(92vw, 1200px);
    max-height: 90vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    background: #fff;
  }
  .lightbox-close {
    position: absolute;
    top: 10px;
    inset-inline-end: 10px;
    z-index: 1;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    border: 0;
    background: #fff;
    font-size: 1rem;
    cursor: pointer;
  }
  @media (max-width: 860px) {
    .hero-grid,
    .need-grid {
      grid-template-columns: 1fr;
    }
  }
  @media print {
    .hero-media {
      padding: 0;
    }
  }
</style>
