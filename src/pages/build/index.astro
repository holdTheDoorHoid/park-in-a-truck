---
// /build/ — intro + a grid of the thirteen furniture/structure assembly
// guides, grouped by category. Owner: guides workstream.
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/guides/GuideCard.astro';
import { getGuidesByCategory } from '../../data/guides';
import guidesMsgs from '../../i18n/messages/en/guides.ts';
import { getT } from '../../i18n/astro.ts';

const groups = getGuidesByCategory();
const t = getT(Astro, guidesMsgs);
---

<Base title={t('crumb')} description={t('index.description')}>
  <header class="wrap" style="padding-top:40px">
    <h1 class="ruled">{t('crumb')}</h1>
    <p class="lede">{t('index.lede')}</p>
    <p class="prose">{t('index.prose')}</p>
  </header>

  {groups.map(({ category, guides }) => (
    <section class="wrap category">
      <h2 class="ruled">{t(`cat.${category}`)}</h2>
      <div class="grid">
        {guides.map((guide) => <GuideCard guide={guide} />)}
      </div>
    </section>
  ))}
</Base>

<style>
  .lede {
    margin-top: 10px;
  }
  .category {
    padding-block: 36px;
    border-top: 1px solid var(--line);
  }
  .category:first-of-type {
    border-top: 0;
  }
  .category h2 {
    margin-bottom: 20px;
  }
</style>
