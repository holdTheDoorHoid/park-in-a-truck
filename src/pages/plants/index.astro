---
// Owner: resources workstream. Words: the plants catalog (src/i18n/messages/en/plants.ts);
// plant and theme names from the plants/themes data overlays (scientific names never change).
import Base from '../../layouts/Base.astro';
import PlantPicker from '../../components/widgets/PlantPicker.astro';
import { PLANTS, type PlantType } from '../../data/plants';
import { THEME_ORDER, THEMES } from '../../data/themes';
import { u } from '../../lib/url';
import plantsMsgs from '../../i18n/messages/en/plants.ts';
import LangFallback from '../../components/site/LangFallback.astro';
import { getT, localizeKeyed, localizeRecord } from '../../i18n/astro.ts';

const t = getT(Astro, plantsMsgs);
const plants = localizeKeyed(PLANTS, 'plants', 'id', t.locale);
const themes = localizeRecord(THEMES, 'themes', t.locale);
const TYPE_KEY = { 'large-tree': 'type.largeTree', 'small-tree': 'type.smallTree', shrub: 'type.shrub', perennial: 'type.perennial' } as const;
const types = (Object.keys(TYPE_KEY) as PlantType[]).map((id) => ({ id, label: t(TYPE_KEY[id]) }));
const LIGHT_KEY = { sun: 'tile.light.sun', shade: 'tile.light.shade', both: 'tile.light.both' } as const;
const english = new Map(PLANTS.map((p) => [p.id, p]));
/** What the search box matches: the shown name, the botanical name and (on translated pages) the English name. */
const searchText = (p: (typeof PLANTS)[number]) =>
  (t.locale === 'en' ? `${p.common} ${p.botanical}` : `${p.common} ${english.get(p.id)!.common} ${p.botanical}`).toLowerCase();
---

<Base title={t('page.title')} description={t('page.description')}>
  <LangFallback area={plantsMsgs}>
  <section class="wrap" style="padding-top:40px">
    <p class="eyebrow">{t('page.eyebrow')}</p>
    <h1 class="ruled">{t('page.title')}</h1>
    <p class="lede">{t('page.lede')}</p>

    <div class="browse no-print">
      <div class="field" style="max-width:20rem">
        <label class="field-label" for="plant-search">{t('page.search')}</label>
        <input id="plant-search" type="text" placeholder={t('page.searchPlaceholder')} data-plant-search />
      </div>
      <div class="browse-filters">
        <div>
          <span class="field-label">{t('page.theme')}</span>
          <div class="chip-row" data-plant-filter="theme">
            <button type="button" class="chip" data-value="">{t('page.all')}</button>
            {THEME_ORDER.map((id) => <button type="button" class="chip" data-value={id}>{themes[id].name}</button>)}
          </div>
        </div>
        <div>
          <span class="field-label">{t('page.type')}</span>
          <div class="chip-row" data-plant-filter="type">
            <button type="button" class="chip" data-value="">{t('page.all')}</button>
            {types.map((x) => <button type="button" class="chip" data-value={x.id}>{x.label}</button>)}
          </div>
        </div>
        <div>
          <span class="field-label">{t('page.light')}</span>
          <div class="chip-row" data-plant-filter="light">
            <button type="button" class="chip" data-value="">{t('page.all')}</button>
            <button type="button" class="chip" data-value="sun">{t('page.sun')}</button>
            <button type="button" class="chip" data-value="shade">{t('page.shade')}</button>
          </div>
        </div>
      </div>
    </div>

    <p class="muted" data-plant-count style="margin-top:1em"></p>

    <div class="plant-grid" data-plant-grid>
      {plants.map((p) => (
        <article
          class="plant-tile"
          data-theme={p.theme}
          data-type={p.type}
          data-light={p.light}
          data-search={searchText(p)}
        >
          <div class="plant-tile-photo" style={`--theme-color:${THEMES[p.theme].frame}`}>
            {p.photo ? <img src={u(p.photo)} alt={t('photo.alt', { common: p.common, botanical: p.botanical })} loading="lazy" /> : <span aria-hidden="true"></span>}
            <span class="plant-tile-theme">{themes[p.theme].name}</span>
          </div>
          <div class="plant-tile-body">
            <p class="plant-tile-common">{p.common}</p>
            <p class="plant-tile-botanical">{p.botanical}</p>
            <p class="plant-tile-meta">
              {t(p.matureSize ? 'tile.metaMature' : 'tile.meta', {
                type: types.find((x) => x.id === p.type)?.label,
                light: t(LIGHT_KEY[p.light]),
                size: p.matureSize,
              })}
            </p>
            {p.notes && <p class="plant-tile-notes">{p.notes}</p>}
            <p class="plant-tile-cost">{t.money(p.unitCost ?? 0, { cents: true })}</p>
          </div>
        </article>
      ))}
    </div>

    <h2 class="ruled" style="margin-top:3em">{t('page.pick')}</h2>
    <p class="prose">{t('page.pickLede')}</p>
    <PlantPicker />
  </section>
  </LangFallback>
</Base>

<style>
  .browse {
    margin-top: 1.5em;
    padding: 16px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    gap: 16px;
  }
  .browse-filters {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 0.4em;
  }
  .chip {
    border: 2px solid var(--line);
    background: #fff;
    border-radius: 999px;
    padding: 0.3em 0.8em;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    border-color: var(--cyan);
    background: var(--cyan-wash);
    color: var(--cyan-deep);
  }

  .plant-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
    margin-top: 1em;
  }
  .plant-tile {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  .plant-tile-photo {
    aspect-ratio: 4 / 3;
    background: var(--paper-2);
    position: relative;
  }
  .plant-tile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plant-tile-theme {
    position: absolute;
    top: 8px;
    inset-inline-start: 8px;
    background: var(--theme-color);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
  }
  .plant-tile-body {
    padding: 10px 12px;
  }
  .plant-tile-common {
    font-weight: 700;
    margin: 0;
  }
  .plant-tile-botanical {
    font-style: italic;
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.1em 0 0.4em;
  }
  .plant-tile-meta,
  .plant-tile-notes {
    font-size: 0.8rem;
    color: var(--ink-2);
    margin: 0.2em 0;
  }
  .plant-tile-cost {
    font-weight: 700;
    margin: 0.4em 0 0;
  }
</style>

<script>
  import plantsMsgs from '../../i18n/messages/en/plants.ts';
  import { getT } from '../../i18n/t.ts';

  const t = getT(undefined, plantsMsgs);
  const grid = document.querySelector<HTMLElement>('[data-plant-grid]');
  const search = document.querySelector<HTMLInputElement>('[data-plant-search]');
  const countEl = document.querySelector<HTMLElement>('[data-plant-count]');
  const filterGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-plant-filter]'));
  const state: Record<string, string> = { theme: '', type: '', light: '' };

  function apply() {
    if (!grid) return;
    const q = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const tile of Array.from(grid.children) as HTMLElement[]) {
      const matchesTheme = !state.theme || tile.dataset.theme === state.theme;
      const matchesType = !state.type || tile.dataset.type === state.type;
      const matchesLight = !state.light || tile.dataset.light === state.light || tile.dataset.light === 'both';
      const matchesSearch = !q || (tile.dataset.search ?? '').includes(q);
      const show = matchesTheme && matchesType && matchesLight && matchesSearch;
      tile.style.display = show ? '' : 'none';
      if (show) visible += 1;
    }
    if (countEl) countEl.textContent = t('page.count', { shown: visible, count: grid.children.length });
  }

  for (const group of filterGroups) {
    const key = group.dataset.plantFilter!;
    const chips = Array.from(group.querySelectorAll<HTMLButtonElement>('.chip'));
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', String(chip.dataset.value === ''));
      chip.addEventListener('click', () => {
        state[key] = chip.dataset.value ?? '';
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        apply();
      });
    }
  }
  search?.addEventListener('input', apply);
  apply();
</script>
