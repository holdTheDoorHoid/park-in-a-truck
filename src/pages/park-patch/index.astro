---
// Park Patch (Pollinator Planting Patch Workbook) — a guided page for small spaces: a 4x4
// plot, a front yard, a window box. Not one of the six steps, so it isn't in src/content/steps
// and doesn't count toward the six-step progress bar, but it uses the same components and the
// same .substep/done-toggle markup (by hand, matching src/lib/rehype-substeps.mjs) so answers
// and "mark done" still save through the normal bind.ts script. Fields are prefixed `patch.`.
import Base from '../../layouts/Base.astro';
import Field from '../../components/workbook/Field.astro';
import Choice from '../../components/workbook/Choice.astro';
import Checklist from '../../components/workbook/Checklist.astro';
import Callout from '../../components/workbook/Callout.astro';
import Figure from '../../components/workbook/Figure.astro';
import PdfPage from '../../components/workbook/PdfPage.astro';
import Download from '../../components/workbook/Download.astro';
import { u } from '../../lib/url';
import patchMsgs from '../../i18n/messages/en/patch.ts';
import workbook from '../../i18n/messages/en/workbook.ts';
import { getT, markdownLinks } from '../../i18n/astro.ts';

const t = getT(Astro, patchMsgs);
const tw = getT(Astro, workbook);
// PiaT's PDF is English in every language: say so, like the chapter PDF links (PdfPage.astro)
const english = t.locale !== 'en';

// `whyKeys` hold full catalog keys (not bare suffixes): t()'s key type is a literal union
// built from the English catalog, and substituting two independent dynamic parts into one
// template (palette id + a bare suffix) would type-check against combinations that don't
// exist. Pre-building the full key per palette keeps every substitution to one dynamic part.
const PALETTES = [
  {
    id: 'grasses-wildflowers',
    img: 'palette-grasses-wildflowers',
    whyKeys: ['palette.grasses-wildflowers.why.sightlines', 'palette.grasses-wildflowers.why.waterWise', 'palette.grasses-wildflowers.why.buffet', 'palette.grasses-wildflowers.why.fullSun', 'palette.grasses-wildflowers.why.color'] as const,
  },
  {
    id: 'grasses-shrubs',
    img: 'palette-grasses-shrubs',
    whyKeys: ['palette.grasses-shrubs.why.screens', 'palette.grasses-shrubs.why.shelter', 'palette.grasses-shrubs.why.structure', 'palette.grasses-shrubs.why.lowMaintenance'] as const,
  },
  {
    id: 'grasses-shrubs-trees',
    img: 'palette-grasses-shrubs-trees',
    whyKeys: ['palette.grasses-shrubs-trees.why.habitat', 'palette.grasses-shrubs-trees.why.resilience', 'palette.grasses-shrubs-trees.why.sanctuary'] as const,
  },
  {
    id: 'grasses-trees',
    img: 'palette-grasses-trees',
    whyKeys: ['palette.grasses-trees.why.elegance', 'palette.grasses-trees.why.airQuality', 'palette.grasses-trees.why.habitat', 'palette.grasses-trees.why.carbon', 'palette.grasses-trees.why.shade'] as const,
  },
] as const;
---
<Base title={t('title')} description={t('description')}>
  <header class="chapter-head">
    <div class="wrap">
      <div class="head-row">
        <h1 class="ruled">{t('title')}</h1>
        <span class="big-num" aria-hidden="true">🌼</span>
      </div>
      <p class="lede">{t('lede')}</p>
      <div class="head-actions no-print">
        <a class="btn btn-small" href={u('downloads/park-patch-workbook.pdf')} target="_blank" rel="noopener" hreflang={english ? 'en' : undefined}>{t('originalPdf')}{english && <span class="file-lang"> · {tw('file.english')}</span>}</a>
        <button class="btn btn-small" type="button" onclick="window.print()">{t('printAnswers')}</button>
      </div>
    </div>
  </header>

  <div class="wrap chapter">
    <article class="prose chapter-body">
      <p>{t('intro')}</p>

      <section class="substep" id="your-planting-area" data-substep="park-patch/your-planting-area">
        <h2 id="your-planting-area-title">{t('yourArea.title')}</h2>
        <p>{t('yourArea.text')}</p>
        <Field id="patch.length" label={t('yourArea.lengthLabel')} type="number" unit="ft" />
        <Field id="patch.width" label={t('yourArea.widthLabel')} type="number" unit="ft" />
        <Field id="patch.sun-area" label={t('yourArea.sunLabel')} />
        <Field id="patch.shade-area" label={t('yourArea.shadeLabel')} />
        <Figure src="img/park-patch/patch-existing-conditions.webp" alt={t('yourArea.alt')} />
        <PdfPage doc="downloads/park-patch-workbook.pdf" page={4} />
        <div class="substep-done" data-done="park-patch/your-planting-area"></div>
      </section>

      <section class="substep" id="choose-a-palette" data-substep="park-patch/choose-a-palette">
        <h2 id="choose-a-palette-title">{t('palette.title')}</h2>
        <p>{t('palette.text')}</p>
        <Choice
          id="patch.palette"
          label={t('palette.chooseLabel')}
          options={PALETTES.map((p) => ({ value: p.id, label: t(`palette.${p.id}.name`), desc: t(`palette.${p.id}.good`) }))}
        />
        {PALETTES.map((p) => (
          <div class="palette-block">
            <h3>{t(`palette.${p.id}.name`)}</h3>
            <ul>{p.whyKeys.map((k) => <li>{t(k)}</li>)}</ul>
            <Figure src={`img/park-patch/${p.img}.webp`} alt={t('palette.alt', { name: t(`palette.${p.id}.name`).toLowerCase() })} />
          </div>
        ))}
        <Download
          href="https://docs.google.com/spreadsheets/d/16DxOfswL57wQZ0B8-4EzEFAO0IQ56LZw-rxQFQRwjcE/edit"
          label={t('palette.plantListLabel')}
          note={t('palette.plantListNote')}
        />
        <PdfPage doc="downloads/park-patch-workbook.pdf" page={5} />
        <div class="substep-done" data-done="park-patch/choose-a-palette"></div>
      </section>

      <section class="substep" id="general-planting-notes" data-substep="park-patch/general-planting-notes">
        <h2 id="general-planting-notes-title">{t('notes.title')}</h2>
        <ul>
          <li>{t('notes.groups')}</li>
          <li>{t('notes.shrubs')}</li>
          <li>{t('notes.trees')}</li>
          <li>{t('notes.mulch')}</li>
          <li>{t('notes.sign')}</li>
        </ul>
        <Callout kind="tip">
          {/* the message keeps PiaT's markdown links: shown as links, page links in the language */}
          <Fragment set:html={markdownLinks(t('notes.callout'), t.locale)} />
        </Callout>
        <PdfPage doc="downloads/park-patch-workbook.pdf" page={14} />
        <div class="substep-done" data-done="park-patch/general-planting-notes"></div>
      </section>

      <section class="substep" id="maintenance" data-substep="park-patch/maintenance">
        <h2 id="maintenance-title">{t('maintenance.title')}</h2>
        <h3>{t('maintenance.firstSeason')}</h3>
        <ul>
          <li>{t('maintenance.waterItem')}</li>
          <li>{t('maintenance.weedItem')}</li>
        </ul>
        <h3>{t('maintenance.secondSeason')}</h3>
        <Checklist
          id="patch.maintenance-ongoing"
          items={[
            { value: 'consult', label: t('maintenance.consult.label'), hint: t('maintenance.consult.hint') },
            { value: 'expand', label: t('maintenance.expand.label'), hint: t('maintenance.expand.hint') },
            { value: 'arborist', label: t('maintenance.arborist.label'), hint: t('maintenance.arborist.hint') },
            { value: 'cutback', label: t('maintenance.cutback.label'), hint: t('maintenance.cutback.hint') },
            { value: 'replace', label: t('maintenance.replace.label'), hint: t('maintenance.replace.hint') },
            { value: 'leaf-mold', label: t('maintenance.leafMold.label'), hint: t('maintenance.leafMold.hint') },
            { value: 'spot-weed', label: t('maintenance.spotWeed.label') },
            { value: 'drought', label: t('maintenance.drought.label'), hint: t('maintenance.drought.hint') },
            { value: 'signs', label: t('maintenance.signs.label'), hint: t('maintenance.signs.hint') },
          ]}
        />
        <Callout kind="note">
          <Fragment set:html={markdownLinks(t('maintenance.sustainNote'), t.locale)} />
        </Callout>
        <PdfPage doc="downloads/park-patch-workbook.pdf" page={15} />
        <div class="substep-done" data-done="park-patch/maintenance"></div>
      </section>

      <section class="substep" id="are-you-ready" data-substep="park-patch/are-you-ready">
        <h2 id="are-you-ready-title">{t('ready.title')}</h2>
        <p>{t('ready.text')}</p>
        <Checklist
          id="patch.ready-checklist"
          items={[
            { value: 'size', label: t('ready.size.label'), hint: t('ready.size.hint') },
            { value: 'plant-choice', label: t('ready.plantChoice.label'), hint: t('ready.plantChoice.hint') },
            { value: 'maintenance', label: t('ready.maintenance.label'), hint: t('ready.maintenance.hint') },
          ]}
        />
        <PdfPage doc="downloads/park-patch-workbook.pdf" page={15} />
        <div class="substep-done" data-done="park-patch/are-you-ready"></div>
      </section>
    </article>
  </div>
</Base>

<style>
  .chapter-head { padding: 40px 0 24px; }
  .head-row { display: flex; align-items: flex-end; gap: 16px; }
  .head-row h1 { flex: 1; margin: 0; }
  .head-row .big-num { font-size: 3rem; border-bottom: 6px solid var(--ink); padding-bottom: 0.05em; }
  .head-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  .chapter-body { max-width: 760px; }
  .palette-block { margin: 1.5em 0 2em; padding-top: 1em; border-top: 1px solid var(--line); }
  .palette-block h3 { margin-bottom: 0.4em; }
</style>
