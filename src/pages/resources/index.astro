---
// Owner: resources workstream.
import Base from '../../layouts/Base.astro';
import { RESOURCES, deadLinkCount } from '../../data/resources';
import { youtubeThumb } from '../../data/parks';
import pages from '../../i18n/messages/en/pages.ts';
import { getT, localizeRecord } from '../../i18n/astro.ts';

const t = getT(Astro, pages);
const resources = localizeRecord(RESOURCES, 'resources', t.locale);

const sections = [
  { id: 'partners', label: t('resources.sections.partners') },
  { id: 'press', label: t('resources.sections.press') },
  { id: 'suppliers', label: t('resources.sections.suppliers') },
  { id: 'toolkit-library', label: t('resources.sections.toolkitLibrary') },
  { id: 'contact', label: t('resources.sections.contact') },
  { id: 'acknowledgments', label: t('resources.sections.acknowledgments') },
  { id: 'legal', label: t('resources.sections.legal') },
];

const deadCount = deadLinkCount();
const deadDate = t.date(new Date().toISOString().slice(0, 10), 'long');

function statusLabel(status: string): string | null {
  if (status === 'dead') return t('resources.status.dead');
  if (status === 'unverified') return t('resources.status.unverified');
  if (status === 'unconfirmed') return t('resources.status.unconfirmed');
  return null;
}
---

<Base title={t('resources.title')} description={t('resources.description')}>
  <section class="wrap" style="padding-top:40px">
    <p class="eyebrow">{t('resources.eyebrow')}</p>
    <h1 class="ruled">{t('resources.title')}</h1>
    <p class="lede">{t('resources.lede')}</p>

    <nav class="res-toc no-print" aria-label={t('resources.sectionsNav')}>
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>

    {deadCount > 0 && (
      <p class="callout callout-warning">
        <span class="callout-title">{t('resources.deadHeadsUp')}</span>
        {t('resources.deadLinks', { count: deadCount, date: deadDate })}
      </p>
    )}

    <h2 id="partners" class="ruled">{sections[0]!.label}</h2>
    <p class="prose">{t('resources.partnersIntro')}</p>
    <div class="grid">
      {resources.partners.map((p) => (
        <div class="card">
          <p class="res-name">
            {p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a> : p.name}
          </p>
          {statusLabel(p.status) && <p class="res-status" data-status={p.status}>{statusLabel(p.status)}</p>}
          <p class="res-desc">{p.description}</p>
        </div>
      ))}
    </div>

    <h2 id="press" class="ruled">{sections[1]!.label}</h2>
    <div class="grid">
      {resources.press.map((item) => (
        <div class="card press-card">
          {item.type === 'video' && item.youtubeId && (
            <a class="press-thumb" href={item.url} target="_blank" rel="noopener noreferrer">
              <img src={youtubeThumb(item.youtubeId)} alt={t('resources.videoAlt', { title: item.title })} loading="lazy" />
              <span class="press-play" aria-hidden="true">▶</span>
            </a>
          )}
          <p class="res-name"><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></p>
          <p class="res-meta">
            {item.outlet}
            {item.byline && <> · {item.byline}</>}
            {item.date && <> · <time datetime={item.date}>{t.date(item.date, 'long')}</time></>}
          </p>
          {item.note && <p class="res-desc">{item.note}</p>}
        </div>
      ))}
    </div>

    <h2 id="suppliers" class="ruled">{sections[2]!.label}</h2>
    <p class="prose">{t('resources.suppliersIntro')}</p>
    {resources.supplierGroups.map((group) => (
      <div class="supplier-group">
        <h3>{group.label}</h3>
        <ul class="supplier-list">
          {group.items.map((item) => (
            <li>
              {item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a> : <span>{item.title}</span>}
              {statusLabel(item.status) && <span class="res-status" data-status={item.status}> — {statusLabel(item.status)}</span>}
              {item.note && <span class="res-note"> — {item.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <h2 id="toolkit-library" class="ruled">{sections[3]!.label}</h2>
    <p class="prose">{resources.toolkitLibrary.intro}</p>
    {resources.toolkitLibrary.sections.map((section) => (
      <div class="supplier-group">
        <h3>{section.title}</h3>
        <ul class="supplier-list">
          {section.entries.map((entry) => (
            <li>
              {entry.url ? <a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.title}</a> : <span>{entry.title}</span>}
              {entry.description && <span class="res-note"> — {entry.description}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <h2 id="contact" class="ruled">{sections[4]!.label}</h2>
    <div class="card" style="max-width:32rem">
      <ul class="contact-list">
        <li><strong>{t('resources.contact.email')}</strong> <a href={`mailto:${RESOURCES.contact.email}`} dir="ltr">{RESOURCES.contact.email}</a></li>
        <li><strong>{t('resources.contact.founder')}</strong> <a href={`mailto:${RESOURCES.contact.founderEmail}`} dir="ltr">{RESOURCES.contact.founderEmail}</a></li>
        <li><strong>{t('resources.contact.phone')}</strong> <a href={`tel:${RESOURCES.contact.phone.replace(/[^0-9]/g, '')}`} dir="ltr">{RESOURCES.contact.phone}</a></li>
        <li><strong>{t('resources.contact.instagram')}</strong> <a href={RESOURCES.contact.instagram.url} target="_blank" rel="noopener noreferrer" dir="ltr">{RESOURCES.contact.instagram.handle}</a></li>
        <li><strong>{t('resources.contact.facebook')}</strong> <a href={RESOURCES.contact.facebook.url} target="_blank" rel="noopener noreferrer">Park in a Truck</a></li>
      </ul>
    </div>

    <h2 id="acknowledgments" class="ruled">{sections[5]!.label}</h2>
    <p class="prose">{resources.acknowledgments.lead}</p>
    <ul class="prose">
      {RESOURCES.acknowledgments.contributors.map((c) => <li>{c}</li>)}
    </ul>
    <p class="prose muted">{resources.acknowledgments.note}</p>

    <h2 id="legal" class="ruled">{resources.legal.title}</h2>
    <p class="muted" style="font-size:0.85rem">{RESOURCES.legal.source}</p>
    <p class="prose">{resources.legal.text}</p>
  </section>
</Base>

<style>
  .res-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 1.5em 0;
    padding: 12px 16px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .res-name {
    font-weight: 700;
    margin: 0 0 0.2em;
  }
  .res-desc,
  .res-meta {
    font-size: 0.88rem;
    color: var(--ink-2);
    margin: 0.2em 0;
  }
  .res-meta {
    color: var(--muted);
  }
  .res-status {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--warn);
  }
  .res-status[data-status='dead'] {
    color: var(--danger);
  }
  .res-note {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .press-card {
    padding: 0;
    overflow: hidden;
  }
  .press-thumb {
    position: relative;
    display: block;
  }
  .press-thumb img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .press-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    display: grid;
    place-items: center;
  }
  .press-card .res-name,
  .press-card .res-meta,
  .press-card .res-desc {
    padding-inline: 16px;
  }
  .press-card .res-name {
    margin-top: 12px;
  }
  .press-card .res-desc {
    padding-bottom: 16px;
  }
  .supplier-group {
    margin: 1.5em 0;
  }
  .supplier-group h3 {
    margin-bottom: 0.4em;
  }
  .supplier-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
  }
  @media (min-width: 720px) {
    .supplier-list {
      columns: 2;
      column-gap: 32px;
    }
  }
  .supplier-list li {
    break-inside: avoid;
    margin: 0.4em 0;
    font-size: 0.92rem;
  }
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contact-list li {
    margin: 0.5em 0;
  }
</style>
