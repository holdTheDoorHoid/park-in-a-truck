---
// Playful Learning Landscapes — the toolkit's own appendix (linked from its Dream chapter,
// next to the theme descriptions: "Park in a Truck has also recently teamed up with Playful
// Learning Landscapes... Check out the appendix for more on this exciting addition!"). A
// 5-page expansion pack, mostly informational rather than fields, so it lives on its own page
// rather than as a Dream sub-step — linked from Dream's "The four themes".
import Base from '../../layouts/Base.astro';
import Figure from '../../components/workbook/Figure.astro';
import Download from '../../components/workbook/Download.astro';
import { THEMES } from '../../data/themes';
import type { ThemeId } from '../../lib/types';
import { u } from '../../lib/url';
import playfulMsgs from '../../i18n/messages/en/playful.ts';
import { getT, localizeRecord } from '../../i18n/astro.ts';

const t = getT(Astro, playfulMsgs);
const themes = localizeRecord(THEMES, 'themes', t.locale);

const PRINCIPLE_IDS = ['activelyEngaging', 'meaningful', 'sociallyInteractive', 'iterative', 'joyful'] as const;
const SIXC_IDS = ['collaboration', 'communication', 'content', 'criticalThinking', 'creativeInnovation', 'confidence'] as const;

const ELEMENTS = [
  { id: 'shapeGames', skills: ['content', 'criticalThinking', 'confidence'] as const },
  { id: 'iconStorytelling', skills: ['collaboration', 'communication', 'creativeInnovation'] as const },
  { id: 'colorTheoryTrellis', skills: ['content', 'criticalThinking', 'communication'] as const },
  { id: 'sortingTables', skills: ['content', 'criticalThinking', 'communication'] as const },
  { id: 'iSpyKeyMural', skills: ['content', 'collaboration', 'criticalThinking'] as const },
  { id: 'puzzleWall', skills: ['collaboration', 'criticalThinking', 'confidence'] as const },
  { id: 'giantRuler', skills: ['content', 'confidence', 'communication'] as const },
  { id: 'colorFlowerSculpture', skills: ['creativeInnovation', 'content', 'collaboration'] as const },
  { id: 'jumpingFeet', skills: ['confidence', 'criticalThinking', 'collaboration'] as const },
  { id: 'storyWheel', skills: ['communication', 'creativeInnovation', 'collaboration'] as const },
] as const;

const BY_THEME: { theme: ThemeId; features: (typeof ELEMENTS)[number]['id'][] }[] = [
  { theme: 'edible', features: ['sortingTables', 'storyWheel', 'giantRuler', 'iconStorytelling'] },
  { theme: 'sanctuary', features: ['puzzleWall', 'colorTheoryTrellis', 'iconStorytelling', 'colorFlowerSculpture'] },
  { theme: 'nature', features: ['iSpyKeyMural', 'jumpingFeet', 'sortingTables', 'shapeGames'] },
  { theme: 'event', features: ['storyWheel', 'shapeGames', 'jumpingFeet', 'iconStorytelling'] },
];

const elementName = (id: (typeof ELEMENTS)[number]['id']) => t(`elements.${id}.name`);
---
<Base title={t('title')} description={t('description')}>
  <header class="chapter-head">
    <div class="wrap">
      <h1 class="ruled">{t('title')}</h1>
      <p class="lede">{t('lede')}</p>
      <div class="head-actions no-print">
        <a class="btn btn-small" href={u('downloads/playful-learning-landscapes.pdf')} target="_blank" rel="noopener">{t('originalPdf')}</a>
      </div>
    </div>
  </header>

  <div class="wrap chapter">
    <article class="prose chapter-body">
      <p>{t('intro1')}</p>
      <p>{t('intro2')}</p>

      <Figure src="img/playful-learning/formula.webp" alt={t('formulaAlt')} />

      <h2>{t('principlesHeading')}</h2>
      <p>{t('principlesIntro')}</p>
      <dl class="definition-grid">
        {PRINCIPLE_IDS.map((id) => (
          <>
            <dt>{t(`principles.${id}.name`)}</dt>
            <dd>{t(`principles.${id}.text`)}</dd>
          </>
        ))}
      </dl>

      <h2>{t('sixCsHeading')}</h2>
      <p>{t('sixCsIntro')}</p>
      <dl class="definition-grid">
        {SIXC_IDS.map((id) => (
          <>
            <dt>{t(`sixCs.${id}.name`)}</dt>
            <dd>{t(`sixCs.${id}.text`)}</dd>
          </>
        ))}
      </dl>

      <h2>{t('communityHeading')}</h2>
      <p>{t('community1')}</p>
      <p>{t('community2')}</p>

      <h2>{t('elementsHeading')}</h2>
      <table class="pll-table">
        <thead><tr><th>{t('elements.col.element')}</th><th>{t('elements.col.description')}</th><th>{t('elements.col.skills')}</th></tr></thead>
        <tbody>
          {ELEMENTS.map((e) => (
            <tr>
              <td><strong>{t(`elements.${e.id}.name`)}</strong></td>
              <td>{t(`elements.${e.id}.text`)}</td>
              <td>{e.skills.map((s) => t(`sixCs.${s}.name`)).join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>{t('byThemeHeading')}</h2>
      <p>{t('byThemeIntro')}</p>
      <table class="pll-table">
        <thead><tr><th>{t('byTheme.col.parkType')}</th><th>{t('byTheme.col.features')}</th></tr></thead>
        <tbody>
          {BY_THEME.map((row) => (
            <tr>
              <td><strong style={`color:${THEMES[row.theme].frame}`}>{themes[row.theme].name}</strong></td>
              <td>{row.features.map(elementName).join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted">{t('byThemeNote')}</p>

      <Download href="downloads/playful-learning-landscapes.pdf" label={t('downloadLabel')} />

      <p class="muted"><Fragment set:html={t.html('learnMore')} /></p>

      <p><a class="btn" href={u('steps/dream/')}>{t('backToDream')}</a></p>
    </article>
  </div>
</Base>

<style>
  .chapter-head { padding: 40px 0 24px; }
  .chapter-body { max-width: 760px; }
  .head-actions { margin-top: 12px; }
  .definition-grid { display: grid; grid-template-columns: max-content 1fr; gap: 0.3em 1.2em; margin: 1em 0 1.6em; }
  .definition-grid dt { font-weight: 800; }
  .definition-grid dd { margin: 0 0 0.6em; color: var(--ink-2); }
  @media (max-width: 560px) {
    .definition-grid { grid-template-columns: 1fr; }
    .definition-grid dd { margin-bottom: 1em; }
  }
  .pll-table { width: 100%; border-collapse: collapse; margin: 1em 0 1.6em; font-size: 0.92rem; }
  .pll-table th, .pll-table td { border: 1px solid var(--line); padding: 0.55em 0.7em; text-align: start; vertical-align: top; }
</style>
