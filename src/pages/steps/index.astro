---
import Base from '../../layouts/Base.astro';
import StepPath from '../../components/site/StepPath.astro';
import pages from '../../i18n/messages/en/pages.ts';
import { getT } from '../../i18n/astro.ts';
const t = getT(Astro, pages);
---
<Base title={t('steps.title')}>
  <section class="wrap" style="padding-top:40px">
    <p class="eyebrow">{t('steps.eyebrow')}</p>
    <h1 class="ruled">{t('steps.h1')}</h1>
    <p class="lede">{t('steps.lede')}</p>
    <div data-progress-total class="total"><span class="bar"><span></span></span> <span data-progress-text></span></div>
    <StepPath />
  </section>
</Base>
<style>
  .total {
    margin: 24px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
  }
  .total .bar {
    flex: 0 1 320px;
    height: 10px;
    background: var(--paper-2);
    border-radius: 5px;
    overflow: hidden;
  }
  .total .bar > span {
    display: block;
    height: 100%;
    width: calc(var(--pct, 0) * 100%);
    background: var(--cyan);
  }
</style>
