---
import Base from '../../layouts/Base.astro';
import StepPath from '../../components/site/StepPath.astro';
import { getCollection } from 'astro:content';
import pages from '../../i18n/messages/en/pages.ts';
import workbook from '../../i18n/messages/en/workbook.ts';
import philly from '../../i18n/messages/en/philly.ts';
import patch from '../../i18n/messages/en/patch.ts';
import guidesMsgs from '../../i18n/messages/en/guides.ts';
import site from '../../i18n/messages/en/site.ts';
import { getT, urlFor, localizeGuide } from '../../i18n/astro.ts';
import { chapterFieldLabels } from '../../i18n/mdx.ts';
import { ASSET_CATEGORIES, assetFieldId } from '../../lib/philly/assets';
import { getGuides } from '../../data/guides';

const t = getT(Astro, pages);
const tw = getT(Astro, workbook);
const u = urlFor(t.locale);

// The answers summary shows each saved answer under its field's own label, in the reader's language:
// the labels the chapters give their fields (the translated chapter where there is one), then the
// fields other pages and widgets save. Unknown ids fall back to a label made from the id.
const tp = getT(Astro, philly);
const tpatch = getT(Astro, patch);
const tg = getT(Astro, guidesMsgs);
const ts = getT(Astro, site);
const fieldLabels: Record<string, string> = {};
for (const e of await getCollection('steps')) Object.assign(fieldLabels, chapterFieldLabels(e.body ?? ''));
for (const e of await getCollection('stepsI18n')) if (e.id.startsWith(`${t.locale}/`)) Object.assign(fieldLabels, chapterFieldLabels(e.body ?? ''));
for (const c of ASSET_CATEGORIES) fieldLabels[assetFieldId(c.id)] ??= tp(`assets.cat.${c.id}`);
Object.assign(fieldLabels, {
  'patch.length': tpatch('yourArea.lengthLabel'),
  'patch.width': tpatch('yourArea.widthLabel'),
  'patch.sun-area': tpatch('yourArea.sunLabel'),
  'patch.shade-area': tpatch('yourArea.shadeLabel'),
  'patch.palette': tpatch('palette.chooseLabel'),
  'patch.maintenance-ongoing': tpatch('maintenance.secondSeason'),
  'patch.ready-checklist': tpatch('ready.title'),
});
for (const g of getGuides().map((x) => localizeGuide(x, t.locale))) {
  fieldLabels[`build.${g.slug}.materials`] = `${g.title} · ${tg('materials')}`;
  fieldLabels[`build.${g.slug}.tools`] = `${g.title} · ${tg('tools')}`;
}
const groupTitles = { patch: tpatch('title'), build: ts('nav.build') };
// JSON for the page script (`<` escaped so nothing in a label can end the <script>)
const labelsJson = JSON.stringify({ fields: fieldLabels, groups: groupTitles }).replace(/</g, '\\u003c');
---
<Base title={t('myPark.title')}>
  <section class="wrap" style="padding-top:40px">
    <p class="eyebrow">{t('myPark.eyebrow')}</p>
    <h1 class="ruled"><span data-project-name>{tw('project.default')}</span></h1>
    <p class="lede">{t('myPark.lede')}</p>
    <p class="storage-warning callout callout-warning" hidden data-storage-warning>
      {t('myPark.storageWarning')}
    </p>

    <div class="tools no-print">
      <div class="card">
        <h3>{t('myPark.thisProject')}</h3>
        <label class="field"><span class="field-label">{t('myPark.nameLabel')}</span><input type="text" data-rename /></label>
        <div class="row">
          <button class="btn" type="button" data-export>{t('myPark.saveFile')}</button>
          <label class="btn">{t('myPark.openFile')}<input type="file" accept=".json,application/json" data-import hidden /></label>
          <button class="btn" type="button" onclick="window.print()">{t('myPark.printEverything')}</button>
        </div>
        <p class="muted small" data-import-msg></p>
      </div>
      <div class="card">
        <h3>{t('myPark.allProjects')}</h3>
        <ul class="projects" data-project-list></ul>
        <div class="row">
          <input type="text" placeholder={t('myPark.newProjectPlaceholder')} data-new-name />
          <button class="btn" type="button" data-new>{t('myPark.newProject')}</button>
        </div>
      </div>
    </div>

    <h2 class="ruled" style="margin-top:40px">{t('myPark.progress')}</h2>
    <StepPath compact />

    <h2 class="ruled" style="margin-top:40px">{t('myPark.yourLot')}</h2>
    <div data-lot-summary><p class="muted" set:html={t.html('myPark.noLotYet', { href: u('steps/acquire/') })} /></div>

    <h2 class="ruled" style="margin-top:40px">{t('myPark.yourAnswers')}</h2>
    <div data-answers><p class="muted">{t('myPark.nothingFilledIn')}</p></div>
    <script is:inline type="application/json" id="field-labels" set:html={labelsJson} />
  </section>
</Base>
<style>
  .tools {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    margin-top: 16px;
  }
  .row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .row input[type='text'] {
    flex: 1 1 160px;
    font: inherit;
    padding: 0.5em 0.6em;
    border: 2px solid #9a9a9a;
    border-radius: var(--radius);
  }
  .projects {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
  }
  .projects li {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .projects li span {
    flex: 1;
  }
  .small {
    font-size: 0.85rem;
  }
  :global([data-answers] h3) {
    margin-top: 1.5em;
  }
  :global([data-answers] dl) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 4px 16px;
    margin: 0;
  }
  :global([data-answers] dt) {
    font-weight: 600;
  }
  :global([data-answers] dd) {
    margin: 0;
    white-space: pre-wrap;
  }
</style>
<script>
  import {
    $project, $projects, $storageOk, renameProject, exportProject, importProject,
    newProject, switchProject, deleteProject,
  } from '../../lib/project';
  import { formatAuto } from '../../lib/autofill';
  import { ownerNames } from '../../lib/philly/owner';
  import { lotGeometry } from '../../lib/philly/choose';
  import { feet } from '../../lib/philly/plain';
  import { isolate } from '../../lib/philly/words';
  import type { LotRecord } from '../../lib/types';
  import mypark from '../../i18n/messages/en/mypark.ts';
  import workbook from '../../i18n/messages/en/workbook.ts';
  import { getT } from '../../i18n/t.ts';
  import { urlFor } from '../../i18n/url.ts';
  import { localizedSteps } from '../../i18n/data.ts';

  // Words in the page's language (<html data-locale>); saved names and answers are shown as they are.
  const t = getT(undefined, mypark);
  const tw = getT(t.locale, workbook);
  const u = urlFor(t.locale);
  const sqft = (n: number) => formatAuto(n, 'sqft', t.locale) ?? '';
  /** A project's name: the starting name is saved in English and shown in the page's language until renamed. */
  const shown = (name: string) => (name === 'My park' ? tw('project.default') : name);
  /** Names and City data keep their own order inside right-to-left text. */
  const iso = (s: string) => isolate(s, t);
  /** The heading of each step's answers: "Acquire" (English keeps its old headings, from the step ids). */
  const stepTitles = new Map(localizedSteps(t.locale).map((st) => [st.slug, st.title]));
  const stepHeading = (g: string) => known.groups?.[g] ?? (t.locale === 'en' ? g[0]!.toUpperCase() + g.slice(1) : (stepTitles.get(g) ?? g));

  /** The same lot size every other page shows: measured from the City's parcel outline. */
  function lotSizeText(lot: LotRecord): string {
    const g = lotGeometry(lot);
    if (g)
      return t('lot.measured', { width: feet(g.widthFt, 1, t.locale), length: feet(g.lengthFt, 1, t.locale), area: sqft(g.areaSqFt) });
    if (lot.frontageFt && lot.depthFt) {
      const v = { frontage: String(lot.frontageFt), depth: String(lot.depthFt) };
      return lot.areaSqFt ? t('lot.record', { ...v, area: sqft(lot.areaSqFt) }) : t('lot.recordNoArea', v);
    }
    return lot.areaSqFt ? sqft(lot.areaSqFt) : '—';
  }
  const noLot = () => `<p class="muted">${t.html('lot.none', { href: u('steps/acquire/') })}</p>`;

  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  /** Field labels and group headings written by the page at build time, in the page's language */
  const known = (() => {
    try {
      return JSON.parse(document.getElementById('field-labels')?.textContent ?? '{}') as { fields?: Record<string, string>; groups?: Record<string, string> };
    } catch {
      return {};
    }
  })();
  const label = (id: string) =>
    known.fields?.[id] ?? id.split('.').slice(1).join(' ').replace(/[-_]/g, ' ').replace(/^\w/, (c) => c.toUpperCase());
  /** Briefly announce a status message through the page's shared polite live region. */
  function announce(text: string) {
    const el = document.getElementById('piat-announce');
    if (!el) return;
    el.textContent = '';
    setTimeout(() => (el.textContent = text), 30);
  }

  $storageOk.subscribe((ok) => ($('[data-storage-warning]') as HTMLElement).toggleAttribute('hidden', ok));

  const rename = $<HTMLInputElement>('[data-rename]');
  // Save on blur (unchanged) *and* as-you-type (debounced), plus a flush
  // right before the page navigates away — relying on blur alone meant a
  // rename typed and then followed straight into a nav link could be lost.
  rename.addEventListener('change', () => renameProject(rename.value));
  let renameTimer: ReturnType<typeof setTimeout> | undefined;
  rename.addEventListener('input', () => {
    clearTimeout(renameTimer);
    renameTimer = setTimeout(() => renameProject(rename.value), 400);
  });
  const flushRename = () => {
    clearTimeout(renameTimer);
    if (document.activeElement === rename) renameProject(rename.value);
  };
  window.addEventListener('pagehide', flushRename);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') flushRename();
  });

  $('[data-export]').addEventListener('click', () => {
    const { filename, blob } = exportProject();
    const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: filename });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  $<HTMLInputElement>('[data-import]').addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    const msg = $('[data-import-msg]');
    try {
      const p = importProject(await f.text());
      msg.textContent = t('import.opened', { name: iso(shown(p.name)) });
    } catch (err) {
      // English shows the reason as it comes; other languages say it in their words
      msg.textContent = t.locale === 'en' ? (err as Error).message : t('import.notProject');
    }
  });
  $('[data-new]').addEventListener('click', () => {
    const inp = $<HTMLInputElement>('[data-new-name]');
    newProject(inp.value || t('project.newDefault'));
    inp.value = '';
  });

  $projects.subscribe((list) => {
    const ul = $('[data-project-list]');
    const active = $project.get().id;
    ul.innerHTML = list
      .map(
        (p) => `<li><span>${esc(iso(shown(p.name)))}${p.id === active ? ` <strong>${esc(t('list.openNow'))}</strong>` : ''}</span>
        ${p.id === active ? '' : `<button class="btn btn-small" data-open="${p.id}">${esc(t('list.open'))}</button>`}
        <button class="btn btn-small" data-del="${p.id}" aria-label="${esc(t('list.deleteLabel', { name: shown(p.name) }))}">${esc(t('list.delete'))}</button></li>`,
      )
      .join('');
    // Both buttons below disappear from their own row once clicked (switching
    // removes "Open", deleting removes the row entirely) — land focus on
    // whatever's left nearby rather than letting it fall through to <body>.
    ul.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b, idx) =>
      b.addEventListener('click', () => {
        switchProject(b.dataset.open!);
        const row = ul.querySelectorAll('li')[idx];
        (row?.querySelector<HTMLElement>('button') ?? rename)?.focus();
      }),
    );
    ul.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b, idx) =>
      b.addEventListener('click', () => {
        const p = list.find((x) => x.id === b.dataset.del);
        if (!p || !confirm(t('delete.confirm', { name: iso(shown(p.name)) }))) return;
        deleteProject(p.id);
        const freshItems = ul.querySelectorAll('li');
        const target =
          freshItems[idx]?.querySelector<HTMLElement>('button') ??
          freshItems[idx - 1]?.querySelector<HTMLElement>('button') ??
          $<HTMLElement>('[data-new-name]');
        target?.focus();
        announce(t('delete.done', { name: shown(p.name) }));
      }),
    );
  });

  $project.subscribe((p) => {
    if (document.activeElement !== rename) rename.value = shown(p.name);
    const lot = p.lot;
    $('[data-lot-summary]').innerHTML = lot
      ? `<dl class="lot"><dt>${esc(t('lot.address'))}</dt><dd>${esc(iso(lot.address))}</dd>
         <dt>${esc(t('lot.owner'))}</dt><dd>${esc(t('lot.ownerLine', { owner: iso(ownerNames(lot.owners)), kind: formatAuto(lot.ownerType, 'ownerType', t.locale) }))}</dd>
         <dt>${esc(t('lot.size'))}</dt><dd>${esc(lotSizeText(lot))}</dd>
         <dt>${esc(t('lot.zoning'))}</dt><dd>${esc(lot.zoning ?? '—')}</dd></dl>`
      : noLot();

    const groups: Record<string, [string, unknown][]> = {};
    for (const [k, v] of Object.entries(p.fields)) (groups[k.split('.')[0]!] ??= []).push([k, v]);
    const order = ['start', 'acquire', 'organize', 'assess', 'dream', 'create', 'sustain'];
    const html = Object.keys(groups)
      // the six steps in order, then Park Patch and the build guides
      .sort((a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99))
      .map((g) => {
        const rows = groups[g]!.map(([k, v]) => {
          const val = Array.isArray(v)
            ? v.map((r) => (typeof r === 'object' ? Object.values(r as object).join(' · ') : r)).join('\n')
            : v;
          return `<dt>${esc(label(k))}</dt><dd>${esc(val)}</dd>`;
        }).join('');
        return `<h3>${esc(stepHeading(g))}</h3><dl>${rows}</dl>`;
      })
      .join('');
    $('[data-answers]').innerHTML = html || `<p class="muted">${esc(t('answers.none'))}</p>`;
  });
</script>
