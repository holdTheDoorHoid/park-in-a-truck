---
import Base from '../layouts/Base.astro';
import StepPath from '../components/site/StepPath.astro';
import LotLookup from '../components/widgets/LotLookup.astro';
import { u } from '../lib/url';
---
<Base title="Park in a Truck">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">A do-it-yourself toolkit for neighborhood parks</p>
      <h1 class="display hero-title">Turn a vacant lot into your neighborhood's park.</h1>
      <p class="lede">
        Park in a Truck walks you and your neighbors through every step — finding a lot, organizing a team, designing
        the park, building it, and keeping it beautiful. This site turns the toolkit into a guided, interactive
        workbook that does the lookups for you.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={u('steps/start/')}>Start here →</a>
        <a class="btn" href={u('steps/')}>See all six steps</a>
      </div>
    </div>
    <div class="hero-art">
      <img
        src={u('img/brand/cover-silhouette.webp')}
        alt="Neighbors unloading a pickup truck labelled Park in a Truck, carrying a bench, planting trees and gardening, with rowhouses behind."
        width="1600"
        height="343"
      />
    </div>
  </section>

  <section class="wrap welcome-back" hidden data-welcome-back>
    <div class="card welcome-card">
      <p class="eyebrow">Welcome back</p>
      <p data-welcome-text></p>
      <div class="cta">
        <a class="btn btn-primary" data-welcome-continue href={u('my-park/')}>See My park →</a>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <h2 class="ruled">Your path</h2>
    <div data-progress-total class="total"><span data-progress-text></span></div>
    <StepPath />
  </section>

  <section class="wrap block">
    <h2 class="ruled">Have a lot in mind?</h2>
    <p class="lede">Type a Philadelphia address. We'll find the owner, the lot size, zoning and the lot's outline — no need to dig through atlas.phila.gov.</p>
    <LotLookup mode="primary" />
  </section>

  <section class="wrap block">
    <h2 class="ruled">Tools that do the legwork</h2>
    <div class="grid">
      <a class="card card-link" href={u('lot/')}><h3>Find a lot</h3><p>Map of vacant land near you with owner, size and zoning.</p></a>
      <a class="card card-link" href={u('planner/')}><h3>Plan in 3D</h3><p>Fit the Park in a Truck park pieces to your real lot and see sun and shade.</p></a>
      <a class="card card-link" href={u('build/')}><h3>Build guides</h3><p>Step-by-step instructions for benches, tables, planters, shade and more.</p></a>
      <a class="card card-link" href={u('plants/')}><h3>Plants</h3><p>Native plant lists for each park theme, for sun and shade.</p></a>
      <a class="card card-link" href={u('parks/')}><h3>Parks built so far</h3><p>See what neighbors across Philadelphia have already created.</p></a>
      <a class="card card-link" href={u('my-park/')}><h3>My park</h3><p>Your answers, saved in this browser. Share a copy with your committee.</p></a>
    </div>
  </section>
</Base>
<style>
  .hero {
    padding-top: 56px;
  }
  .hero .lede {
    max-width: 44rem;
  }
  .hero-title {
    font-size: clamp(2.2rem, 5.4vw, 4.2rem);
    line-height: 1.05;
    margin-bottom: 0.4em;
    max-width: 14em;
  }
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  /* The toolkit cover: silhouettes standing on a heavy black ground line. */
  .hero-art {
    max-width: var(--max);
    margin: 24px auto 0;
    padding-inline: var(--gutter);
  }
  .hero-art img {
    width: 100%;
    height: auto;
    border-bottom: 10px solid var(--ink);
  }
  .block {
    padding-top: 48px;
  }
  .total {
    margin: -4px 0 16px;
    color: var(--muted);
  }
  .welcome-back {
    padding-top: 24px;
  }
  .welcome-card {
    border-color: var(--cyan);
    background: var(--cyan-wash);
  }
  .welcome-card .eyebrow {
    margin: 0 0 0.3em;
  }
  .welcome-card p:not(.eyebrow) {
    margin: 0;
    font-size: 1.1rem;
  }
  .welcome-card .cta {
    margin-top: 16px;
  }
</style>
<script>
  // F5 (novice-phone): a returning visitor with progress or a chosen lot
  // used to see the same first-time homepage, with the only sign anything
  // was saved being a small dot on "My park" two screens down. Surface it
  // here instead, above "Your path", linking straight to the next
  // unfinished sub-step. Nothing shows for a first-time, empty project.
  import { $project } from '../lib/project';
  import { STEPS } from '../data/steps';
  import { u } from '../lib/url';
  import type { Project } from '../lib/types';

  function nextUnfinished(p: Project) {
    const outline: Record<string, string[]> = (window as any).__PIAT_OUTLINE__ ?? {};
    for (const step of STEPS) {
      const subs = outline[step.slug] ?? [];
      const id = subs.find((sid) => !p.done[`${step.slug}/${sid}`]);
      if (id) return { title: step.title, href: u(`steps/${step.slug}/#${id}`) };
    }
    return null;
  }

  $project.subscribe((p: Project) => {
    const section = document.querySelector<HTMLElement>('[data-welcome-back]');
    if (!section) return;
    const hasProgress = Object.keys(p.done).length > 0 || Boolean(p.lot);
    section.hidden = !hasProgress;
    if (!hasProgress) return;

    const text = section.querySelector('[data-welcome-text]')!;
    const where = p.lot?.address ? `your lot at ${p.lot.address}` : 'your project';
    text.textContent = `Continue with ${where}.`;

    const link = section.querySelector<HTMLAnchorElement>('[data-welcome-continue]')!;
    const next = nextUnfinished(p);
    if (next) {
      link.textContent = `Continue: ${next.title} →`;
      link.href = next.href;
    } else {
      link.textContent = 'See My park →';
      link.href = u('my-park/');
    }
  });
</script>
