---
import Base from '../layouts/Base.astro';
import StepPath from '../components/site/StepPath.astro';
import LotLookup from '../components/widgets/LotLookup.astro';
import pages from '../i18n/messages/en/pages.ts';
import { getT, urlFor } from '../i18n/astro.ts';
const t = getT(Astro, pages);
const u = urlFor(t.locale);
const tools = (['lot', 'planner', 'build', 'plants', 'parks', 'myPark'] as const).map((k) => ({
  href: k === 'myPark' ? 'my-park/' : `${k}/`,
  title: t(`home.tool.${k}`),
  text: t(`home.tool.${k}.text`),
}));
---
<Base title="Park in a Truck">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1 class="display hero-title">{t('home.title')}</h1>
      <p class="lede">{t('home.lede')}</p>
      <div class="cta">
        <a class="btn btn-primary" href={u('steps/start/')}>{t('home.start')}</a>
        <a class="btn" href={u('steps/')}>{t('home.allSteps')}</a>
      </div>
    </div>
    <div class="hero-art">
      <img
        src={u('img/brand/cover-silhouette.webp')}
        alt={t('home.heroAlt')}
        width="1600"
        height="343"
      />
    </div>
  </section>

  <section class="wrap block">
    <h2 class="ruled">{t('home.path')}</h2>
    <div data-progress-total class="total"><span data-progress-text></span></div>
    <StepPath />
  </section>

  <section class="wrap block">
    <h2 class="ruled">{t('home.lotTitle')}</h2>
    <p class="lede">{t('home.lotLede')}</p>
    <LotLookup mode="primary" />
  </section>

  <section class="wrap block">
    <h2 class="ruled">{t('home.tools')}</h2>
    <div class="grid">
      {tools.map((x) => (
        <a class="card card-link" href={u(x.href)}><h3>{x.title}</h3><p>{x.text}</p></a>
      ))}
    </div>
  </section>
</Base>
<style>
  .hero {
    padding-top: 56px;
  }
  .hero .lede {
    max-width: 44rem;
  }
  .hero-title {
    font-size: clamp(2.2rem, 5.4vw, 4.2rem);
    line-height: 1.05;
    margin-bottom: 0.4em;
    max-width: 14em;
  }
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  /* The toolkit cover: silhouettes standing on a heavy black ground line. */
  .hero-art {
    max-width: var(--max);
    margin: 24px auto 0;
    padding-inline: var(--gutter);
  }
  .hero-art img {
    width: 100%;
    height: auto;
    border-bottom: 10px solid var(--ink);
  }
  .block {
    padding-top: 48px;
  }
  .total {
    margin: -4px 0 16px;
    color: var(--muted);
  }
</style>
