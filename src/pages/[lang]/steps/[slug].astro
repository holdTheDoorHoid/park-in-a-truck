---
// /steps/[slug]/ in every other language: the same page, which reads its language from the URL
// (and shows the translated chapter when there is one). See src/i18n/routes.ts.
import Page, { getStaticPaths as english } from '../../steps/[slug].astro';
import { localeStaticPaths } from '../../../i18n/routes.ts';
export const getStaticPaths = () => localeStaticPaths(english());
const { entry } = Astro.props;
---
<Page entry={entry} />
