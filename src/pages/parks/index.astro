---
// Owner: resources workstream. Words: the parks catalog (src/i18n/messages/en/parks.ts);
// descriptions etc. from the parks data overlay (park names and addresses never change).
import Base from '../../layouts/Base.astro';
import ParksMap from '../../components/widgets/ParksMap.astro';
import { PARKS, youtubeThumb, youtubeWatchUrl } from '../../data/parks';
import { u } from '../../lib/url';
import parksMsgs from '../../i18n/messages/en/parks.ts';
import { getT, localizeKeyed } from '../../i18n/astro.ts';

const t = getT(Astro, parksMsgs);
const parks = localizeKeyed(PARKS, 'parks', 'id', t.locale);

// The data's "Source:" lines and photo credits are English; put the language's words around the
// names (papers, people and quoted names stay as they are). Anything not recognised is shown as is.
function sourceText(source: string): string {
  return source
    .split('; ')
    .map((part) => {
      const ack = /^Park in a Truck toolkit p\.(\d+) acknowledgments(?: (\(.+\)))?$/.exec(part);
      if (ack) return t('source.toolkitAck', { page: ack[1]! }) + (ack[2] ? ` ${ack[2]}` : '');
      const pages = /^Park in a Truck toolkit (pp?)\.(.+)$/.exec(part);
      if (pages) return pages[1] === 'p' ? t('source.toolkitPage', { page: pages[2]! }) : t('source.toolkitPages', { pages: pages[2]! });
      const linktree = /^Park in a Truck Linktree( only)?$/.exec(part);
      if (linktree) return t(linktree[1] ? 'source.linktreeOnly' : 'source.linktree');
      if (part === 'unconfirmed elsewhere') return t('source.unconfirmedElsewhere');
      if (part === 'unconfirmed beyond that') return t('source.unconfirmedBeyond');
      if (part === 'Jefferson news') return t('source.jeffersonNews');
      return t.isolate(part);
    })
    .join('; ');
}
function creditText(credit: string): string {
  if (credit === 'Park in a Truck toolkit') return t('photo.toolkit');
  const via = /^(.+), via the Park in a Truck toolkit$/.exec(credit);
  return via ? t('photo.via', { name: via[1]! }) : t.isolate(credit);
}
---

<Base title={t('page.title')} description={t('page.description')}>
  <section class="wrap" style="padding-top:40px">
    <p class="eyebrow">{t('page.eyebrow')}</p>
    <h1 class="ruled">{t('page.title')}</h1>
    <p class="lede">{t('page.lede')}</p>

    <ParksMap />

    <div class="park-list">
      {parks.map((park) => (
        <article id={`park-${park.id}`} class="park-card">
          {park.photos.length > 0 && (
            <div class="park-photos">
              {park.photos.map((photo) => (
                <figure>
                  <img src={u(photo.src)} alt={photo.alt} loading="lazy" />
                  {(photo.caption || photo.credit) && (
                    <figcaption>{photo.credit ? t('photo.credit', { caption: photo.caption ?? '', credit: creditText(photo.credit) }) : photo.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          )}
          <div class="park-card-body">
            <h2>{park.name}</h2>
            <p class="park-meta">
              <bdi>{park.address}</bdi>
              {park.neighborhood && <> · {park.neighborhood}</>}
              {park.year && <> · {t('park.opened', { year: String(park.year) })}</>}
            </p>
            <p class="prose">{park.description}</p>

            {park.videos.length > 0 && (
              <div class="park-videos">
                {park.videos.map((v) => (
                  <a class="park-video" href={youtubeWatchUrl(v.id)} target="_blank" rel="noopener noreferrer">
                    <img src={youtubeThumb(v.id)} alt={t('video.alt', { title: v.title })} loading="lazy" />
                    <span class="park-video-play" aria-hidden="true">▶</span>
                    <span class="park-video-title">{v.title}{v.channel && <> · {v.channel}</>}</span>
                  </a>
                ))}
              </div>
            )}

            {park.links.length > 0 && (
              <ul class="park-links">
                {park.links.map((l) => (
                  <li><a href={l.url} target="_blank" rel="noopener noreferrer" hreflang="en">{l.label}</a>{t.locale !== 'en' && ` ${t('link.english')}`}</li>
                ))}
              </ul>
            )}

            {park.source && <p class="park-source muted">{t('park.source', { source: sourceText(park.source) })}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .park-list {
    display: grid;
    gap: 28px;
    margin-top: 2em;
  }
  .park-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    scroll-margin-top: 100px;
  }
  .park-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }
  .park-photos figure {
    margin: 0;
  }
  .park-photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .park-photos figcaption {
    padding: 6px 10px;
    background: var(--paper-2);
  }
  .park-card-body {
    padding: 20px;
  }
  .park-card-body h2 {
    margin-bottom: 0.2em;
  }
  .park-meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 0.9em;
  }
  .park-videos {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    margin: 1em 0;
  }
  .park-video {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
  }
  .park-video img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .park-video-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 2.4em;
    height: 2.4em;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 1rem;
  }
  .park-video-title {
    display: block;
    padding: 6px 10px;
    font-size: 0.82rem;
    font-weight: 600;
    background: var(--paper-2);
    color: var(--ink);
  }
  .park-links {
    list-style: none;
    margin: 0.8em 0 0;
    padding: 0;
    font-size: 0.9rem;
  }
  .park-links li {
    margin: 0.3em 0;
  }
  .park-source {
    margin-top: 1em;
    font-size: 0.78rem;
  }
</style>
