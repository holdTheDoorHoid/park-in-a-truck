---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { getOutline } from '../lib/outline';
import { u } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** full-bleed pages (planner, maps) skip the footer margin */
  bare?: boolean;
}
const { title, description = 'Plan, build and care for a neighborhood park with the Park in a Truck toolkit.', bare = false } = Astro.props;
const outline = Object.fromEntries(Object.entries(await getOutline()).map(([k, v]) => [k, v.map((s) => s.id)]));
const fullTitle = title === 'Park in a Truck' ? title : `${title} · Park in a Truck`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
    <script is:inline define:vars={{ outline }}>window.__PIAT_OUTLINE__ = outline;</script>
  </head>
  <body class={bare ? 'bare' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="piat-announce" class="visually-hidden" role="status" aria-live="polite"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/bind.ts';
    </script>
  </body>
</html>
