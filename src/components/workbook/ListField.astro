---
// A repeatable table of rows, e.g. committee members or candidate lots.
// Saved as an array of {column-key: value} under `id`.
import workbook from '../../i18n/messages/en/workbook.ts';
import { getT } from '../../i18n/astro.ts';
interface Column {
  key: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'date' | 'number' | 'url';
  placeholder?: string;
}
interface Props {
  id: string;
  label: string;
  columns: Column[];
  min?: number;
  rowName?: string;
  hint?: string;
}
const t = getT(Astro, workbook);
const { id, label, columns, min = 3, rowName = t('list.row'), hint } = Astro.props;
---
<div class="field" style="max-width:none">
  <span class="field-label">{label}</span>
  <piat-list data-field={id} data-label={label} data-columns={JSON.stringify(columns)} data-min={min} data-row-name={rowName}>
    <noscript>{t('list.noscript')}</noscript>
  </piat-list>
  {hint && <span class="field-hint">{hint}</span>}
</div>
