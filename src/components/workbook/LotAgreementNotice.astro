---
// site-added: a tracking helper, not advice from the workbook. Shown on
// Assess, Dream and Create when Acquire's "Secure your lot" isn't marked
// done and no agreement is recorded — shown/hidden and wired up centrally
// in src/scripts/bind.ts (same place as every other data-* behaviour), so
// this component is just the markup. Dismissible per project
// (project.extra.lotNoticeDismissed).
import workbook from '../../i18n/messages/en/workbook.ts';
import { getT, urlFor } from '../../i18n/astro.ts';
const t = getT(Astro, workbook);
const u = urlFor(t.locale);
---

<div class="callout callout-warning lot-agreement-notice" hidden data-lot-agreement-notice>
  <span class="callout-title">{t('notice.title')}</span>
  <p set:html={t.html('notice.lot', { href: u('steps/acquire/#secure-your-lot') })} />
  <button type="button" class="btn btn-small" data-dismiss="lot-agreement">{t('notice.dismiss')}</button>
</div>

<style>
  .lot-agreement-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
  }
  .lot-agreement-notice[hidden] {
    display: none;
  }
  .lot-agreement-notice p {
    margin: 0;
    flex: 1 1 20rem;
  }
</style>
