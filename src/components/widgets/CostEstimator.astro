---
// Cost estimator widget (cost workstream): Park in a Truck's cost spreadsheet
// as a live form, prefilled from the design, with the order list.
// Usage in a chapter: <CostEstimator />  or  <CostEstimator focus="order" title="Your order list" />
import Island from '../cost/CostEstimator';

interface Props {
  /** Heading above the estimator (default "Your cost estimate") */
  title?: string;
  /** "order" opens the order list first (Create chapter) */
  focus?: 'estimate' | 'order';
  [key: string]: unknown;
}
const { title, focus } = Astro.props;
---
<Island client:visible title={title} focus={focus} />
