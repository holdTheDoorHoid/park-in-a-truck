---
// The 3D park planner (planner workstream). Preact island, client-only: Three.js
// and the planner code download only on pages that include this widget.
//   <Planner />               design mode (Dream): size & themes, arrange, sun, counts
//   <Planner mode="site" />   existing conditions + sun & shade (Assess)
//   <Planner mode="full" />   everything, with the step rail (the /planner page uses this)
import PlannerApp from '../planner/PlannerApp';
import LangFallback from '../site/LangFallback.astro';
import plannerMsgs from '../../i18n/messages/en/planner.ts';
import { getT } from '../../i18n/astro.ts';

interface Props {
  mode?: 'design' | 'site' | 'full' | 'sun';
  /** start on a demo lot instead of the person's own */
  demo?: 'dover' | 'greenway';
  [key: string]: unknown;
}
const { mode = 'design', demo } = Astro.props;
const t = getT(Astro, plannerMsgs);
const label = t(mode === 'site' ? 'widget.siteLabel' : 'widget.designLabel');
---
<section class="planner-widget no-print" aria-label={label}>
  <LangFallback area={plannerMsgs}>
    <PlannerApp client:only="preact" mode={mode} demo={demo}>
      <div slot="fallback" class="widget-placeholder">{t('widget.loading')}</div>
    </PlannerApp>
  </LangFallback>
  <noscript>
    <p class="widget-placeholder">{t('widget.noscript')}</p>
  </noscript>
</section>
