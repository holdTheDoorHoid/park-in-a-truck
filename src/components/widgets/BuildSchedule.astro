---
// Build schedule: the 8 Create-step phases laid out on consecutive weekends, each date
// editable, with an optional "skip a weekend" and an .ics export. Logic lives in
// src/components/schedule/ (pure, unit-tested); this just mounts the Preact island.
// Owner: content-b.
//
// client:only="preact" (not client:visible): this island's first render depends on the
// saved project (localStorage via src/lib/project.ts), which does not exist during SSR —
// SSR and client would render different content (no lot address, a fresh blank project),
// so hydration would mismatch. Rendering purely client-side avoids that, at the cost of a
// blank placeholder until the bundle loads.
import BuildScheduleIsland from '../schedule/BuildScheduleIsland';
interface Props { [key: string]: unknown }
---
<BuildScheduleIsland client:only="preact" />
