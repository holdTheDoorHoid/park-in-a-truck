---
// Seasonal stewardship checklist: the Sustain workbook's annual workplan as a month-by-month
// list, current month highlighted, with a yearly-recurring .ics export. Logic lives in
// src/components/schedule/ (pure, unit-tested); this just mounts the Preact island.
// Owner: content-b.
//
// client:only="preact" (not client:visible): this island's first render depends on the
// saved project (localStorage via src/lib/project.ts), which does not exist during SSR, so
// SSR and client would otherwise render different content and mismatch on hydration.
import StewardshipCalendarIsland from '../schedule/StewardshipCalendarIsland';
import LangFallback from '../site/LangFallback.astro';
import scheduleMsgs from '../../i18n/messages/en/schedule.ts';
interface Props { [key: string]: unknown }
---
<LangFallback area={scheduleMsgs}>
  <StewardshipCalendarIsland client:only="preact" />
</LangFallback>
