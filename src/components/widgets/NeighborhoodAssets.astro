---
// Organize: community organizations (RCOs), council district & member, park
// friends groups, schools, libraries, rec centers & parks, hospitals, colleges,
// community gardens, public art, historic places near the chosen lot, grouped
// like the workbook's lists. Ticked items are saved as string[] fields
// "organize.assets-<category>" (rcos, council, friends, schools, libraries,
// parks, hospitals, universities, gardens, art, historic) and print on My park.
import NeighborhoodAssetsIsland from '../philly/NeighborhoodAssets.tsx';
import '../philly/philly.css';
import LangFallback from '../site/LangFallback.astro';
import phillyMsgs from '../../i18n/messages/en/philly.ts';
import { getT } from '../../i18n/astro.ts';
interface Props { [key: string]: unknown }
const t = getT(Astro, phillyMsgs);
---
<div class="ph-widget" data-widget="NeighborhoodAssets">
  <LangFallback area={phillyMsgs}>
    <NeighborhoodAssetsIsland client:only="preact">
      <div slot="fallback" class="ph-fallback">{t('loading.assets')}</div>
    </NeighborhoodAssetsIsland>
  </LangFallback>
</div>
