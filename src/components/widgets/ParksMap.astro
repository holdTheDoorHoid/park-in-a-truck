---
// Owner: resources workstream.
import ParksMapIsland from '../parks/ParksMapIsland';
import { PARKS } from '../../data/parks';
---

{/* client:idle, not client:visible -- `client:visible` watches the
    astro-island element with IntersectionObserver, but astro-island is
    `display: contents` by default, and IntersectionObserver never fires a
    callback for a display:contents target in at least some Chromium builds
    (a known, long-standing engine limitation, confirmed directly: an
    IntersectionObserver placed on this exact element never calls back).
    client:idle still keeps the ~200kb maplibre-gl bundle out of the initial
    render's critical path (it loads via requestIdleCallback after first
    paint) without depending on that observer. */}
<ParksMapIsland parks={PARKS} client:idle />

<style is:global>
  .parks-map-wrap {
    position: relative;
    margin: 1.5em 0;
  }
  .parks-map {
    width: 100%;
    height: 420px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper-2);
  }
  @media (max-width: 480px) {
    .parks-map {
      height: 320px;
    }
  }
  .parks-marker {
    width: 22px;
    height: 22px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--cyan);
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.4);
    cursor: pointer;
    padding: 0;
  }
  .parks-marker:hover {
    background: var(--cyan-ink);
  }
  /* The default focus ring is cyan-ink, same family as this pin's own cyan
     fill — on a cluster of overlapping pins a focused one was impossible to
     tell from an unfocused one. Use a colour nothing else on this marker is,
     with an offset ring the pin's own rotated shape can't hide. */
  .parks-marker:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .parks-map-card {
    position: absolute;
    left: 12px;
    bottom: 12px;
    max-width: min(320px, calc(100% - 24px));
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    display: flex;
    overflow: hidden;
  }
  .parks-map-card img {
    width: 96px;
    height: 96px;
    object-fit: cover;
    flex: none;
  }
  .parks-map-card-body {
    padding: 10px 12px;
    min-width: 0;
  }
  .parks-map-card-name {
    font-weight: 700;
    margin: 0 0 0.2em;
  }
  .parks-map-card-addr {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0 0 0.5em;
  }
  .parks-map-card-close {
    position: absolute;
    top: 2px;
    right: 4px;
    border: 0;
    background: none;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: var(--muted);
    padding: 4px 8px;
  }
  .maplibregl-ctrl-attrib {
    font-size: 0.7rem;
  }
</style>
