---
// Assess "Diagram your lot": the chosen lot on 1-ft grid paper (heavy lines
// every 4 ft), each side labelled in feet, project starting point at a street
// corner, north arrow, scale bar, neighbors' lot lines; prints on Letter
// landscape at a stated architectural scale. Needs a chosen lot (project.lot).
import BaseMapIsland from '../philly/BaseMap.tsx';
import '../philly/philly.css';
import LangFallback from '../site/LangFallback.astro';
import phillyMsgs from '../../i18n/messages/en/philly.ts';
import { getT } from '../../i18n/astro.ts';
interface Props { [key: string]: unknown }
const t = getT(Astro, phillyMsgs);
---
<div class="ph-widget" data-widget="BaseMap">
  <LangFallback area={phillyMsgs}>
    <BaseMapIsland client:only="preact">
      <div slot="fallback" class="ph-fallback">{t('loading.basemap')}</div>
    </BaseMapIsland>
  </LangFallback>
</div>
