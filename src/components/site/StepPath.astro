---
// The six-step path (plus "Start here"), with live progress from the saved project.
import site from '../../i18n/messages/en/site.ts';
import { getT, urlFor, localizedSteps } from '../../i18n/astro.ts';
interface Props {
  current?: string;
  compact?: boolean;
}
const { current, compact = false } = Astro.props;
const t = getT(Astro, site);
const u = urlFor(t.locale);
const STEPS = localizedSteps(t.locale);
const ICON: Record<string, string> = {
  start: 'img/brand/step-start.webp',
  acquire: 'img/brand/step-acquire.webp',
  organize: 'img/brand/step-organize.webp',
  assess: 'img/brand/step-assess.webp',
  dream: 'img/brand/step-dream.webp',
  create: 'img/brand/step-create.webp',
  sustain: 'img/brand/step-sustain.webp',
};
---
<ol class:list={['path', { compact }]}>
  {STEPS.map((s) => (
    <li>
      <a class="card card-link step" href={u(`steps/${s.slug}/`)} aria-current={current === s.slug ? 'step' : undefined} data-progress-step={s.slug}>
        <img class="step-icon" src={u(ICON[s.slug])} alt="" aria-hidden="true" loading="lazy" width="120" height="100" />
        <span class="num" aria-hidden="true">{s.n === 0 ? '00' : String(s.n).padStart(2, '0')}</span>
        <span class="title">{s.title}</span>
        {!compact && <span class="tag">{s.tagline}</span>}
        <span class="bar" aria-hidden="true"><span></span></span>
        <span class="count"><span data-progress-text>—</span><span class="visually-hidden"> {t('path.subDone')}</span></span>
      </a>
    </li>
  ))}
</ol>
<style>
  .path {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(140px, 100%), 1fr));
  }
  .compact {
    grid-template-columns: repeat(auto-fill, minmax(min(130px, 100%), 1fr));
    gap: 8px;
  }
  .step {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    position: relative;
  }
  .step-icon {
    width: 100%;
    max-width: 120px;
    height: auto;
    aspect-ratio: 6 / 5;
    object-fit: contain;
    object-position: left center;
    margin-bottom: 4px;
  }
  :global([dir='rtl']) .step-icon {
    object-position: right center;
  }
  .compact .step-icon {
    max-width: 72px;
  }
  .compact .step {
    padding: 10px 12px;
  }
  .num {
    font-family: var(--font-display);
    /* --cyan text fails contrast on white (2.70:1); --cyan-ink passes. */
    color: var(--cyan-ink);
    font-size: 2.2rem;
    line-height: 1;
  }
  .compact .num {
    font-size: 1.4rem;
  }
  .title {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .tag {
    font-size: 0.9rem;
    color: var(--ink-2);
    flex: 1;
  }
  .bar {
    display: block;
    height: 6px;
    background: var(--paper-2);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 8px;
  }
  .bar > span {
    display: block;
    height: 100%;
    width: calc(var(--pct, 0) * 100%);
    background: var(--cyan);
    transition: width 0.3s;
  }
  .step[data-state='done'] .bar > span {
    background: var(--ok);
  }
  .count {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .step[aria-current='step'] {
    border-color: var(--cyan);
    border-width: 2px;
  }
</style>
