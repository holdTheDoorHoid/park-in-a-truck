---
import site from '../../i18n/messages/en/site.ts';
import { getT, urlFor } from '../../i18n/astro.ts';
const t = getT(Astro, site);
const u = urlFor(t.locale);
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="wordmark-sm">PARK <small>in a</small> TRUCK</p>
      <p>{t('footer.about')}</p>
    </div>
    <div>
      <h3 class="footer-heading">{t('footer.questions')}</h3>
      <p>
        {/* addresses, the phone number and the handle read left to right in every language */}
        <a href="mailto:ParkinaTruck@jefferson.edu" dir="ltr">ParkinaTruck@jefferson.edu</a><br />
        <a href="mailto:Kimberlee.Douglas@jefferson.edu" dir="ltr">Kimberlee.Douglas@jefferson.edu</a><br />
        <a href="tel:+12159510115" dir="ltr">215-951-0115</a><br />
        <a href="https://www.instagram.com/parkinatruck" dir="ltr">@parkinatruck</a>
      </p>
    </div>
    <div>
      <h3 class="footer-heading">{t('footer.aboutSite')}</h3>
      <p set:html={t.html('footer.saved', { href: u('my-park/') })} />
      <p><a href={u('resources/')}>{t('footer.resources')}</a> · <a href={u('resources/#legal')}>{t('footer.legal')}</a></p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: 80px;
    border-top: 6px solid var(--ink);
    background: var(--paper-2);
    padding: 32px 0 48px;
    font-size: 0.92rem;
  }
  .cols {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }
  .wordmark-sm {
    font-weight: 900;
    font-size: 1.1rem;
    margin: 0 0 0.5em;
  }
  .wordmark-sm small {
    font-weight: 600;
    font-size: 0.75em;
  }
  /* Semantically an h3 (the page has no h3 above it — skipping straight to
     h4 broke "jump by heading level" screen-reader navigation), styled to
     keep the small uppercase look the footer always had. */
  .footer-heading {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.4em;
  }
  p {
    margin: 0 0 0.8em;
  }
</style>
