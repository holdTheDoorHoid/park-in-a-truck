---
// A card for the /build/ grid: thumbnail, title, dimensions.
import { u as fileUrl } from '../../lib/url';
import { feetIn } from './format';
import type { Guide } from '../../data/guides';
import guidesMsgs from '../../i18n/messages/en/guides.ts';
import { getT, urlFor, localizeGuide } from '../../i18n/astro.ts';

interface Props {
  guide: Guide;
}
const t = getT(Astro, guidesMsgs);
const u = urlFor(t.locale);
const guide = localizeGuide(Astro.props.guide, t.locale);
const d = guide.dimensionsIn;
---

<a class="card card-link guide-card" href={u(`build/${guide.slug}/`)}>
  <div class="thumb">
    <img src={fileUrl(`img/guides/${guide.slug}/thumb.webp`)} alt={t('heroAlt', { title: guide.title })} loading="lazy" decoding="async" />
  </div>
  <h3>{guide.title}</h3>
  <p class="dims">{t('dims', { length: feetIn(d.length), width: feetIn(d.width), height: feetIn(d.height) })}</p>
  <p class="summary">{guide.summary}</p>
</a>

<style>
  .guide-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: var(--paper-2);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }
  .guide-card h3 {
    margin: 14px 16px 0;
    font-size: 1.05rem;
    font-weight: 800;
  }
  .dims {
    margin: 4px 16px 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--cyan-ink);
    letter-spacing: 0.01em;
  }
  .summary {
    margin: 6px 16px 16px;
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
</style>
