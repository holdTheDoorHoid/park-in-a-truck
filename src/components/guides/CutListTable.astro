---
// The lumber cut list, straight from the PDF's "mark, label and cut" step.
import type { GuideCutListItem } from '../../data/guides';
import guidesMsgs from '../../i18n/messages/en/guides.ts';
import { getT } from '../../i18n/astro.ts';

interface Props {
  items: GuideCutListItem[];
}
const { items } = Astro.props;
const t = getT(Astro, guidesMsgs);
const head = { part: t('cut.part'), qty: t('cut.qty'), stock: t('cut.stock'), length: t('cut.length'), notes: t('cut.notes') };
---

<table class="cutlist">
  <caption class="visually-hidden">{t('cut')}</caption>
  <thead>
    <tr>
      <th scope="col">{head.part}</th>
      <th scope="col">{head.qty}</th>
      <th scope="col">{head.stock}</th>
      <th scope="col">{head.length}</th>
      <th scope="col">{head.notes}</th>
    </tr>
  </thead>
  <tbody>
    {items.map((it) => (
      <tr>
        <td data-label={head.part}><span class="part">{it.part}</span></td>
        <td data-label={head.qty}>{it.qty}</td>
        <td data-label={head.stock}>{it.stock}</td>
        <td data-label={head.length}>{it.lengthIn}"</td>
        <td data-label={head.notes}>
          {it.notes}
          {it.siteNote && (
            <span class="site-note"><strong>{t('siteNote')}</strong> {it.siteNote}</span>
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .cutlist {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 0 0 1.25em;
  }
  .cutlist th {
    text-align: start;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-block: 0 6px;
    padding-inline: 0 10px;
    border-bottom: 2px solid var(--ink);
  }
  .cutlist td {
    padding-block: 8px;
    padding-inline: 0 10px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .part {
    display: inline-block;
    font-weight: 800;
    background: var(--cyan-wash);
    color: var(--cyan-deep);
    border-radius: var(--radius);
    padding: 0.1em 0.5em;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  /* matches the dashed "Note from this site" callout (global.css .callout-site) */
  .site-note {
    display: block;
    margin-top: 6px;
    padding: 6px 10px;
    border: 2px dashed var(--ink-2);
    border-inline-start: 4px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper);
    font-size: 0.88rem;
  }
  @media (max-width: 640px) {
    .cutlist thead {
      display: none;
    }
    .cutlist tr {
      display: grid;
      gap: 2px;
      padding: 10px 0;
    }
    .cutlist td {
      border-bottom: 0;
      padding: 1px 0;
    }
    .cutlist td[data-label]::before {
      content: attr(data-label) ': ';
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
    }
    .cutlist tr + tr {
      border-top: 1px solid var(--line);
    }
  }
</style>
